<h1>出品中の書籍</h1>

<%# [BAD] 検索フォームをここでベタ書き。 partial 化されておらず、 他のページの検索欄と挙動が分かれる %>
<%= form_with url: books_path, method: :get, local: true do %>
  <%= text_field_tag :q, params[:q], placeholder: "タイトル/著者/説明" %>
  <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: "すべて" %>
  <%= number_field_tag :min_price, params[:min_price], placeholder: "最低価格" %>
  <%= number_field_tag :max_price, params[:max_price], placeholder: "最高価格" %>
  <%= submit_tag "検索" %>
<% end %>

<% @books.each do |book| %>
  <div class="book-card">
    <h3><%= link_to book.title, book_path(book) %></h3>
    <p>著者: <%= book.author %> / カテゴリ: <%= book.category&.name %></p>
    <%# [BAD] view で N+1 が発生する書き方。 book.seller を毎回読みに行く。 %>
    <p>出品者: <%= link_to book.seller.name, user_path(book.seller) %>
      (評価: <%= book.seller.average_rating %> / <%= book.seller.rating_label %>)
    </p>
    <%# [BAD] 税計算を view でやっている。 さらに送料も view で再計算。 %>
    <p class="price">
      ¥<%= book.price %>
      (税込 ¥<%= (book.price * 1.1).to_i %> + 送料 <%
        if book.price >= 5000
          %>無料<%
        elsif book.price >= 1000
          %>¥300<%
        else
          %>¥500<%
        end %>)
    </p>
    <span class="badge"><%= book.status_label %></span>
  </div>
<% end %>
