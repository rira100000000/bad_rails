<%= form_with model: @book, local: true do |f| %>
  <% if @book.errors.any? %>
    <div class="flash alert">
      <ul>
        <% @book.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="field"><%= f.label :title %><br><%= f.text_field :title %></div>
  <div class="field"><%= f.label :author %><br><%= f.text_field :author %></div>
  <div class="field"><%= f.label :description %><br><%= f.text_area :description %></div>
  <div class="field"><%= f.label :price, "価格(円)" %><br><%= f.number_field :price %></div>
  <div class="field"><%= f.label :condition %><br>
    <%= f.select :condition, ["新品同様", "良い", "普通", "やや傷あり"] %>
  </div>
  <div class="field"><%= f.label :category_id %><br>
    <%= f.collection_select :category_id, @categories, :id, :name, include_blank: true %>
  </div>
  <div class="field"><%= f.label :isbn %><br><%= f.text_field :isbn %></div>
  <%= f.submit %>
<% end %>
