<h1>通知一覧</h1>

<table>
  <tr><th>日時</th><th>種類</th><th>メッセージ</th><th></th></tr>
  <% @notifications.each do |n| %>
    <tr style="<%= 'background:#fff3cd' unless n.read %>">
      <td><%= n.created_at.strftime("%Y-%m-%d %H:%M") %></td>
      <td><%= n.notification_type %></td>
      <td><%= n.message %></td>
      <td>
        <% unless n.read %>
          <%= button_to "既読", read_notification_path(n), method: :post %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
