<h1>新規登録</h1>
<%= form_with model: @user, url: signup_path, local: true do |f| %>
  <% if @user.errors.any? %>
    <div class="flash alert">
      <ul>
        <% @user.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="field"><%= f.label :name %><br><%= f.text_field :name %></div>
  <div class="field"><%= f.label :email %><br><%= f.email_field :email %></div>
  <div class="field"><%= f.label :password %><br><%= f.password_field :password %></div>
  <div class="field"><%= f.label :address %><br><%= f.text_field :address %></div>
  <div class="field"><%= f.label :phone %><br><%= f.text_field :phone %></div>
  <%= f.submit "登録" %>
<% end %>
