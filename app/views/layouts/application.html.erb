<!DOCTYPE html>
<html>
  <head>
    <title>BadBooks - 設計勉強会用</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { font-family: -apple-system, sans-serif; margin: 0; padding: 0; background: #fafafa; color: #222; }
      header { background: #222; color: #fff; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; }
      header a { color: #fff; margin-right: 12px; text-decoration: none; }
      header a:hover { text-decoration: underline; }
      .container { max-width: 960px; margin: 20px auto; padding: 0 20px; }
      .flash { padding: 10px; margin: 10px 0; border-radius: 4px; }
      .flash.notice { background: #d4edda; color: #155724; }
      .flash.alert  { background: #f8d7da; color: #721c24; }
      .book-card { background: #fff; padding: 12px; margin: 8px 0; border: 1px solid #e0e0e0; border-radius: 4px; }
      .book-card h3 { margin: 0 0 8px 0; }
      .price { color: #d9534f; font-weight: bold; }
      .badge { display: inline-block; padding: 2px 6px; background: #eee; border-radius: 3px; font-size: 12px; }
      form .field { margin: 8px 0; }
      input[type=text], input[type=email], input[type=password], input[type=number], textarea, select { width: 300px; padding: 6px; }
      button, input[type=submit] { background: #337ab7; color: #fff; padding: 8px 16px; border: 0; border-radius: 4px; cursor: pointer; }
      table { border-collapse: collapse; width: 100%; background: #fff; }
      th, td { padding: 8px; border: 1px solid #ddd; text-align: left; }
    </style>
  </head>

  <body>
    <header>
      <div>
        <%= link_to "BadBooks", root_path %>
        <%= link_to "出品する", new_book_path %>
        <% if logged_in? %>
          <%= link_to "注文履歴", orders_path %>
          <%= link_to "通知 (#{current_user.unread_notifications_count})", notifications_path %>
        <% end %>
      </div>
      <div>
        <% if logged_in? %>
          <%= link_to current_user.display_name, user_path(current_user) %>
          <%= button_to "ログアウト", logout_path, method: :delete, style: "display:inline; background:#aaa" %>
        <% else %>
          <%= link_to "ログイン", login_path %>
          <%= link_to "新規登録", signup_path %>
        <% end %>
      </div>
    </header>

    <div class="container">
      <% flash.each do |type, msg| %>
        <div class="flash <%= type %>"><%= msg %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
